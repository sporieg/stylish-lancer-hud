{
  "name": "stylish-lancer-hud",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -w",
    "lint": "oxlint  --type-aware --type-check",
    "lint:fix": "oxlint  --fix --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
